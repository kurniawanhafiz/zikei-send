# --- Build-time (frontend) -------------------------------------------------
# Only set if the signaling server lives on a different host than the site:
# VITE_SIGNAL_URL=wss://signal.example.com/ws

# --- Runtime (Netlify Server env vars, scope: Functions) --------------------
# Optional TURN relay so connections work on strict networks. Redeploy after changing.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=<coturn static-auth-secret>      # recommended: short-lived credentials
# or:
# TURN_USERNAME=
# TURN_CREDENTIAL=
# STUN_URLS=stun:stun.example.com:3478        # optional override of the public Google STUN default
# ALLOWED_ORIGINS=send.example.com            # optional: only accept WebSockets from these hosts
